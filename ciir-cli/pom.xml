<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.ftathiago.ciir</groupId>
    <artifactId>ciir-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>ciir-cli</artifactId>
  <packaging>jar</packaging>

  <name>ciir-cli</name>
  <description>
    Composition root and command-line adapter. Contains no analysis logic: parses arguments,
    wires the concrete adapters, and calls into ciir-application.
  </description>

  <dependencies>
    <dependency>
      <groupId>dev.ftathiago.ciir</groupId>
      <artifactId>ciir-application</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.ftathiago.ciir</groupId>
      <artifactId>ciir-java</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.ftathiago.ciir</groupId>
      <artifactId>ciir-serialization</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>ciir-cli</finalName>
    <plugins>
      <!-- CliExitCodeIT spawns the built ciir-cli.jar as a real subprocess, so it must run after
           `package` (which the default `test` phase runs before) — bound to `integration-test`. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.ftathiago.ciir.cli.Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
