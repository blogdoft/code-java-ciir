#!/usr/bin/env bash
# Auto-formats staged Java files with Spotless (google-java-format, Google style) before every
# commit, mirroring the C# sibling repo's Husky.Net + `dotnet format` pre-commit hook.
#
# One-time setup per clone:
#   git config core.hooksPath .githooks
set -euo pipefail

# Git hooks run with whatever PATH the invoking process (a terminal, an IDE, ...) had - which may
# not include SDKMAN's shims (e.g. a non-login shell, or an IDE's git integration). Prepend the
# current candidates' bin dirs directly rather than sourcing sdkman-init.sh: that script assumes
# an interactive bash/zsh (it references $ZSH_VERSION unguarded) and aborts under `set -u` here.
if ! command -v mvn >/dev/null 2>&1; then
  for candidate in maven java; do
    dir="$HOME/.sdkman/candidates/$candidate/current/bin"
    [ -d "$dir" ] && PATH="$dir:$PATH"
  done
  export PATH
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Files staged for this commit, before formatting touches anything.
staged_java_files="$(git diff --cached --name-only --diff-filter=ACM -- '*.java')"

echo "Running spotless:apply..."
mvn -q spotless:apply

# Re-stage only the ones that were actually staged for this commit and that spotless changed.
if [ -n "$staged_java_files" ]; then
  echo "$staged_java_files" | while IFS= read -r file; do
    if [ -f "$file" ] && ! git diff --quiet -- "$file"; then
      git add "$file"
    fi
  done
fi
